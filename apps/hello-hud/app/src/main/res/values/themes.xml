<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fullscreen, no action bar — the HUD should be all content. -->
    <style name="Theme.HelloHud" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/hud_background</item>
        <item name="android:navigationBarColor">@color/hud_background</item>
    </style>
</resources>
