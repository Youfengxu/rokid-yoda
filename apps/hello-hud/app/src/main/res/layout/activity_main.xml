<?xml version="1.0" encoding="utf-8"?>
<!--
  HUD layout for the 480x640 green-monochrome display.
  Black background, one large bright-green centered line. Keep it sparse.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_background">

    <TextView
        android:id="@+id/hud_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/hud_foreground"
        android:textSize="40sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="24dp"
        tools:ignore="HardcodedText"
        xmlns:tools="http://schemas.android.com/tools" />

</FrameLayout>
