<?xml version="1.0" encoding="utf-8"?>
<!--
  The orchestrator is a private HTTP endpoint on your LAN / tailnet. Allow cleartext
  only to those hosts; everything else stays HTTPS-only. Add hosts here if you move
  the orchestrator or reach it via a different tailnet name.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.100.21</domain>
        <domain includeSubdomains="true">k11-services.border-balance.ts.net</domain>
    </domain-config>
</network-security-config>
